{
  "name": "rent-lens",
  "version": "0.1.1",
  "description": "Local-first rental research workspace for Facebook rental posts.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite --host 127.0.0.1",
    "server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^6.0.2",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.2"
  }
}
